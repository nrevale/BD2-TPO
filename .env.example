# Copiar a .env solo si se quiere cambiar algún valor (todo tiene default).
# docker compose lee este archivo desde la raíz del repo.

# Contraseña de Neo4j (mínimo 8 caracteres).
NEO4J_PASSWORD=farmared123

# Nombre de la base de MongoDB.
MONGO_DB=farmared

# Fija "hoy" (AAAA-MM-DD) para demos y tests. Vacío = fecha real del sistema (Buenos Aires).
FARMARED_HOY=

# Solo para correr Python desde el host (fuera del contenedor):
# MONGO_URI=mongodb://localhost:27017/?directConnection=true
# NEO4J_URI=bolt://localhost:7687
